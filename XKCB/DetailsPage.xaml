<Page
    x:Class="XKCB.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XKCB"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Grid Background="Black">

     
        <Grid>
            <Image Grid.Column="1" x:Name="BackdropImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="768" Opacity="0.2" />
        </Grid>

        <!-- 2. CONTENT LAYER (Vertically Centered Layout) -->
        <Grid Padding="60,60,10,20" MaxWidth="1920" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="420" Height="630" CornerRadius="18" Margin="0,0,100,0" VerticalAlignment="Center">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Border.Background>
                    <ImageBrush x:Name="PosterImageBrush" Stretch="UniformToFill" />
                </Border.Background>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- NEW: Spacer Row -->
                    <RowDefinition Height="Auto" />
                    <!-- Title Row -->
                    <RowDefinition Height="Auto" />
                    <!-- Content Row (Sources/Seasons) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- NEW: Conditional Spacer. It pushes the Title down ONLY when the Movie Sources section is visible. -->
                <Border Grid.Row="0" Height="300" Visibility="{Binding ElementName=SourcesSection, Path=Visibility}" />

                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="TitleText" FontSize="50" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="0,40,0,0">
                        <TextBlock.Shadow>
                            <ThemeShadow />
                        </TextBlock.Shadow>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="6,0,0,22">
                        <TextBlock x:Name="YearText" FontSize="15" Foreground="#D4D4D4"/>
                        <TextBlock Text="•" FontSize="15" Foreground="#525252"/>
                        <TextBlock x:Name="RatingText" FontSize="15" Foreground="#FACC15" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="2">

                    <!-- FIX: Removed hardcoded Height="150" and added VerticalAlignment="Top" -->
                    <StackPanel x:Name="SourcesSection" Visibility="Collapsed" VerticalAlignment="Top" Background="#000000" Padding="24" CornerRadius="8" BorderBrush="#1A1A1A" BorderThickness="1" HorizontalAlignment="Left" MinWidth="700">
                        <TextBlock Text="SELECT SOURCE" FontSize="12" FontFamily="Consolas" Foreground="#737373" Margin="0,0,0,16" CharacterSpacing="100"/>
                        <ItemsControl x:Name="SourcesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MovieSource">
                                    <Button Click="PlayButton_Click" Tag="{x:Bind Id}" Background="Transparent" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="6" Padding="24,12" Margin="0,0,16,16" MinWidth="160">
                                        <TextBlock Text="{x:Bind VariationName}" Foreground="#E5E5E5" FontFamily="Consolas" FontSize="14" CharacterSpacing="50" HorizontalAlignment="Center"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Grid x:Name="SeasonsSection" Visibility="Collapsed" Background="#080808" CornerRadius="8" BorderBrush="#1A1A1A" BorderThickness="1" Margin="0,0,26,0" HorizontalAlignment="Stretch" MaxWidth="900">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Padding="24,24,24,16" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
                            <TextBlock Text="AVAILABLE SEASONS" FontSize="12" FontFamily="Consolas" Foreground="#737373" Margin="0,0,0,16" CharacterSpacing="50"/>
                            <ItemsControl x:Name="SeasonsList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapGrid Orientation="Horizontal" MaximumRowsOrColumns="-1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:Season">
                                        <Button Loaded="SeasonButton_Loaded" Click="SeasonButton_Click" Tag="{x:Bind SeasonNumber}" 
                                                Background="Transparent" CornerRadius="6" Padding="24,10" Margin="0"
                                                Transitions="{x:Null}">
                                            <TextBlock FontFamily="Consolas" FontSize="14" FontWeight="Bold" CharacterSpacing="50">
                                                <Run Text="Season "/>
                                                <Run Text="{x:Bind SeasonNumber}"/>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Padding="24,16,24,24" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="EpisodesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:Episode">
                                        <Button Click="PlayButton_Click" Tag="{x:Bind Id}" 
                                                Background="#0F0F0F" BorderBrush="Transparent" CornerRadius="8" 
                                                Padding="16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="Black" CornerRadius="4" Padding="8,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                    <TextBlock Foreground="#737373" FontFamily="Consolas" FontWeight="Bold" FontSize="12">
                                                        <Run Text="{x:Bind EpisodeNumber}"/>
                                                    </TextBlock>
                                                </Border>

                                                <TextBlock Grid.Column="1" Text="{x:Bind EpisodeName}" Foreground="#D1D1D1" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="2" Background="Black" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Quality}" Foreground="#737373" FontFamily="Consolas" FontSize="10"/>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>

        <!-- Back Button -->
        <Button Content="← Back" Click="BackButton_Click" Style="{ThemeResource TextBlockButtonStyle}" Foreground="#A3A3A3" FontFamily="Consolas" FontSize="20" CharacterSpacing="100" Margin="20,20,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
    </Grid>
</Page>