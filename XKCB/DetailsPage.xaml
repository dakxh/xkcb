<Page
    x:Class="XKCB.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:XKCB"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#0A0A0A">

    <Grid>
        <Image x:Name="BackdropImage" Stretch="UniformToFill" Opacity="0.4" VerticalAlignment="Top" Height="600"/>

        <Border VerticalAlignment="Top" Height="600">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0.5" />
                    <GradientStop Color="#0A0A0A" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <StackPanel Padding="40" VerticalAlignment="Bottom" MaxWidth="1200" HorizontalAlignment="Left">

            <Button Content="← Back to Catalog" Click="BackButton_Click" Style="{ThemeResource TextBlockButtonStyle}" Foreground="#AAAAAA" Margin="0,0,0,20"/>

            <TextBlock x:Name="TitleText" FontSize="48" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
            <TextBlock x:Name="YearText" FontSize="20" Foreground="#CCCCCC" Margin="0,4,0,24"/>

            <TextBlock Text="AVAILABLE STREAMS" FontSize="14" FontWeight="SemiBold" Foreground="#888888" Margin="0,0,0,12" CharacterSpacing="100"/>

            <ListView x:Name="SourcesList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:MovieSource">
                        <Border Background="#1A1A1A" CornerRadius="8" Padding="16,12" Margin="0,0,0,8" BorderBrush="#333333" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="{x:Bind VariationName}" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                                <Button Content="PLAY" Click="PlayButton_Click" Tag="{x:Bind Id}" HorizontalAlignment="Right" Background="#E50914" Foreground="White" CornerRadius="4" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </Grid>
</Page>