<Page
    x:Class="XKCB.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <Grid>
        <SwapChainPanel x:ConnectionId='2' x:Name="VideoSurface" />

        <Grid x:ConnectionId='3' x:Name="ControlsOverlay" VerticalAlignment="Top" Padding="24" Background="#88000000">
            <Button x:ConnectionId='4' Content="← Close Player"                           Foreground="White" Style="{ThemeResource TextBlockButtonStyle}" FontSize="16"/>
        </Grid>
    </Grid>
</Page>

